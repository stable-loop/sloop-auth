- raise ArgumentError, "role must be host or guest" unless %w[host guest].include?(role.to_s)
.peer-link.mb-2{ data: { controller: "peer", peer_role_value: role, pairing_error: t("setting.peer.pairing_error"), invalid_error: t("setting.peer.invalid_error"), connection_error: t("setting.peer.connection_error"), qr_error: t("setting.peer.qr_error"), camera_error: t("setting.peer.camera_error"), denied_error: t("setting.peer.denied_error"), insecure_error: t("setting.peer.insecure_error") } }
  %button.btn.btn-secondary.btn-sm{ type: "button", title: t("setting.peer.title"), data: { peer_target: "toggle", action: "peer#toggle" }, "aria-expanded" => "false", "aria-controls" => "peer-link-panel" }
    %i.bi.bi-wifi
  - if role.to_s == "guest"
    %span.ms-1= t("setting.peer.title")
  #peer-link-panel.card.mt-1{ hidden: true, data: { peer_target: "panel" } }
    .card-body
      %p= t("setting.peer.intro")
      %p.text-danger{ role: "alert", "aria-live" => "assertive", data: { peer_target: "error" } }
      %div{ data: { peer_target: "step", step: "start" } }
        - if role.to_s == "host"
          %p= t("setting.peer.host_start")
          %button.btn.btn-primary{ type: "button", data: { action: "peer#start" } }= t("setting.peer.start")
        - else
          %p= t("setting.peer.guest_start")
          %button.btn.btn-primary{ type: "button", data: { action: "peer#scan" } }= t("setting.peer.scan_button")
      %div{ hidden: true, data: { peer_target: "step", step: "working" }, role: "status" }= t("setting.peer.working")
      %div{ hidden: true, data: { peer_target: "step", step: "host-show guest-show" } }
        - if role.to_s == "host"
          %p= t("setting.peer.host_show")
        - else
          %p= t("setting.peer.guest_show")
        .bg-white.d-inline-block.p-2{ data: { peer_target: "qr" }, role: "img", "aria-label" => t("setting.peer.qr_label") }
        %label.d-block.mt-2
          = t("setting.peer.copy_code")
          %textarea.form-control{ readonly: true, rows: 3, data: { peer_target: "code" } }
        - if role.to_s == "host"
          %button.btn.btn-primary.mt-2{ type: "button", data: { action: "peer#scan" } }= t("setting.peer.host_next")
      %div{ hidden: true, data: { peer_target: "step", step: "scan" } }
        %p= t(role.to_s == "host" ? "setting.peer.host_scan" : "setting.peer.guest_scan")
        %video.w-100{ playsinline: true, muted: true, "aria-label" => t("setting.peer.camera_preview"), data: { peer_target: "video" } }
        %button.btn.btn-outline-primary.mb-2{ type: "button", data: { action: "peer#scan" } }= t("setting.peer.retry_camera")
        %label.d-block
          = t("setting.peer.paste_code")
          %textarea.form-control{ rows: 3, maxlength: 12000, data: { peer_target: "input" } }
        %button.btn.btn-primary.mt-2{ type: "button", data: { action: "peer#submit" } }= t("setting.peer.use_code")
      %p{ hidden: true, data: { peer_target: "step", step: "connecting" }, role: "status" }= t("setting.peer.connecting")
      %p{ hidden: true, data: { peer_target: "step", step: "connected" }, role: "status" }= t("setting.peer.connected")
      %p{ hidden: true, data: { peer_target: "step", step: "disconnected" }, role: "status" }= t("setting.peer.disconnected")
      %button.btn.btn-outline-secondary.mt-3{ type: "button", data: { action: "peer#reset" } }= t("setting.peer.cancel")
