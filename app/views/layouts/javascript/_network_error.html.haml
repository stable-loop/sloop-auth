:javascript
  // Global handler for Turbo network errors
  document.addEventListener("turbo:submit-end", function(event) {
    if (!event.detail.fetchResponse && event.detail.success === false) {
      console.error(`Turbo network error: ${event.detail.error}`, event.detail);
      // alert(`NETWORK ERROR: Please check your connection and try again: ${event.detail.error}`);
    }
  });