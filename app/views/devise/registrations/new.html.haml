.row.justify-content-center.mt-4
  .col-12.col-sm-10.col-md-6.col-lg-4
    .card.shadow-sm
      .card-body.p-4
        %h2.h4.text-center.mb-4= t 'user.sign_up'
        = render "devise/shared/links"
        .d-flex.align-items-center.my-4.text-muted.small
          %hr.flex-grow-1.m-0
          %span.px-3= t 'user.or_with_email'
          %hr.flex-grow-1.m-0
        = form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f|
          = render "devise/shared/error_messages", resource: resource
          .mb-3
            = f.label :email, t('user.email'), class: 'form-label small'
            = f.email_field :email, autofocus: true, autocomplete: "email", class: 'form-control'
          .mb-3
            = f.label :password, t('user.password'), class: 'form-label small'
            - if @minimum_password_length
              %span.text-muted.small= t('user.min_password', count: @minimum_password_length)
            = f.password_field :password, autocomplete: "new-password", class: 'form-control'
            .form-text= t 'user.password_hint'
          .mb-3
            = f.label :password_confirmation, t('user.password_confirmation'), class: 'form-label small'
            = f.password_field :password_confirmation, autocomplete: "new-password", class: 'form-control'
          = f.submit t('user.sign_up'), class: 'btn btn-outline-secondary w-100'
        %p.text-center.small.text-muted.mt-4.mb-0
          = t 'user.have_account'
          = link_to t('user.sign_in'), new_session_path(resource_name)
