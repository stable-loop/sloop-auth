.row.justify-content-center.mt-4
  .col-12.col-sm-10.col-md-6.col-lg-4
    .card.shadow-sm
      .card-body.p-4
        %h2.h4.text-center.mb-4= t 'user.sign_in'
        = render "devise/shared/links"
        .d-flex.align-items-center.my-4.text-muted.small
          %hr.flex-grow-1.m-0
          %span.px-3= t 'user.or_with_email'
          %hr.flex-grow-1.m-0
        = form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
          .mb-3
            = f.label :email, t('user.email'), class: 'form-label small'
            = f.email_field :email, autofocus: true, autocomplete: "email", class: 'form-control'
          .mb-3
            = f.label :password, t('user.password'), class: 'form-label small'
            = f.password_field :password, autocomplete: "current-password", class: 'form-control'
          - if devise_mapping.rememberable?
            .form-check.mb-3
              = f.check_box :remember_me, class: 'form-check-input'
              = f.label :remember_me, t('user.remember_me'), class: 'form-check-label small'
          = f.submit t('user.sign_in'), class: 'btn btn-outline-secondary w-100'
        - if devise_mapping.registerable?
          %p.text-center.small.text-muted.mt-4.mb-0
            = t 'user.no_account'
            = link_to t('user.sign_up'), new_registration_path(resource_name)
