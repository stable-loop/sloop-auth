- content_for(:title) { t("docs.install.title") }

%h1= t("docs.install.title")
%p= t("docs.install.intro")
%nav{ "aria-label": t("docs.install.contents") }
  %ul
    - %w[android ios desktop packages].each do |platform|
      %li= link_to t("docs.install.#{platform}.title"), "##{platform}"

- %w[android ios desktop].each do |platform|
  %section.mb-4{ id: platform }
    %h2= t("docs.install.#{platform}.title")
    - if platform == "desktop"
      %h3.h5= t("docs.install.desktop.chromium_title")
    %ol
      - t("docs.install.#{platform}.steps").each do |step|
        %li= step
    - if platform == "desktop"
      %h3.h5= t("docs.install.desktop.safari_title")
      %ol
        - t("docs.install.desktop.safari_steps").each do |step|
          %li= step
    - else
      = render partial: 'docs/install', locals: { platform: }
    %p= t("docs.install.#{platform}.note")

%section.mb-4#packages
  %h2= t("docs.install.packages.title")
  %p= t("docs.install.packages.intro")
  = link_to t("docs.install.packages.link"), downloads_path, class: "btn btn-primary"
  .row.g-3.mt-2
    - %w[linux windows macos android].each do |platform|
      .col-md-6.col-lg-3
        %h3.h5= t("docs.install.packages.#{platform}.title")
        %p.mb-0= t("docs.install.packages.#{platform}.body")

%section
  %h2= t("docs.install.after.title")
  %p= t("docs.install.after.session")
  %p= t("docs.install.after.offline")
