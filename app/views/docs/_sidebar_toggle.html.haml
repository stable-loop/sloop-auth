%button.btn.btn-outline-secondary.btn-sm.mb-3.docs-sidebar-toggle{ type: "button", title: t("docs.toggle_sidebar"), data: { bs_toggle: "collapse", bs_target: "#docs-sidebar" }, "aria-label" => t("docs.toggle_sidebar"), "aria-expanded" => "true", "aria-controls" => "docs-sidebar" }
  %i.bi.bi-arrow-left.docs-sidebar-toggle-icon--expanded{ "aria-hidden" => "true" }
  %i.bi.bi-arrow-right.docs-sidebar-toggle-icon--collapsed{ "aria-hidden" => "true" }
  %span.docs-sidebar-toggle-label= t("docs.hide")
